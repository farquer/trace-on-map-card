{
  "name": "trace-on-map-card",
  "version": "1.0.0",
  "description": "Home Assistant Lovelace card: HA default map with history timeline playback",
  "main": "trace-on-map-card.js",
  "scripts": {
    "build": "rollup -c rollup.config.js",
    "build:dev": "rollup -c rollup.config.js",
    "build:minify": "rollup -c rollup.config.js && terser trace-on-map-card.js -o trace-on-map-card.min.js --compress --mangle && mv trace-on-map-card.min.js trace-on-map-card.js",
    "dev": "rollup -c rollup.config.js --watch",
    "lint": "eslint src/**/*.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["home-assistant", "lovelace", "map", "history"],
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "jsdom": "^28.1.0",
    "rollup": "^3.0.0",
    "terser": "^5.18.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^0.34.6"
  }
}
